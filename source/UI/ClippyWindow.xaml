<Window x:Class="c4r.UI.ClippyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:c4r.UI"
        mc:Ignorable="d" Height="258" Width="565.332" Background="Transparent" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" ShowInTaskbar="False" ToolTip="Click to cycle animation, right click to close."
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Canvas x:Name="ClippyCanvas" HorizontalAlignment="Left" Height="180" Margin="20,20,0,0" VerticalAlignment="Top" Width="236" MouseDown="ClippyCanvas_OnMouseDown" ClipToBounds="True"/>
        <Polygon Name="BubbleCorner" Points="0,0 30,0 30,30" Fill="LightGoldenrodYellow" Stroke="Black" StrokeThickness="1" Margin="256,40,0,34"/>

        <Border Name="BubbleBody" Background="LightGoldenrodYellow" BorderBrush="Black" BorderThickness="1" CornerRadius="6" Padding="12" Margin="284,20,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="262" Height="218" >
            <TextBlock Name="BubbleText" Text="Text" TextWrapping="Wrap" FontSize="20" Margin="8,8,6,26" />
        </Border>
        <Button Name="BubbleButton" Content="ok" HorizontalAlignment="Left" Height="26" Margin="468,198,0,0" VerticalAlignment="Top" Width="64" FontSize="16" Click="BubbleButton_Click"/>

    </Grid>

</Window>
